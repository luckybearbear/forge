<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.luckybearbear</groupId>
    <artifactId>forge-services</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>forge-service-organization</artifactId>
  <name>Forge :: Service :: Organization</name>
  <description>组织服务：组织树（环检测/删除保护）+ 岗位 + 用户挂岗（服务=自动配置库形态，照抄 service-tenant 范式）。</description>
  <dependencies>
    <!-- 服务=自动配置库（范式同 service-tenant）：data-starter 供 JPA/审计/软删/Flyway 基建，
         spring-boot-starter 供 web/异常/前缀路由 -->
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-data-starter</artifactId></dependency>
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-spring-boot-starter</artifactId></dependency>
    <!-- 契约消费：organization（OrgUnitDTO/OrgTreeQueryService/OrgUnitChanged/错误码）、
         identity（挂岗时 userId 存在性经 UserQueryService 校验——实现方为 service-identity，
         本模块不依赖任何 service，测试以 @Bean 桩供契约 bean） -->
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-contract-organization</artifactId></dependency>
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-contract-identity</artifactId></dependency>
    <!-- 主代码直接使用 Result/BusinessException（app/controller 层）——显式声明而非依赖契约的传递，
         防克隆模块时误判可用性 -->
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-platform-core</artifactId></dependency>
    <!-- tests -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-platform-test</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
