<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.luckybearbear</groupId>
    <artifactId>forge-services</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>forge-service-authorization</artifactId>
  <name>Forge :: Service :: Authorization</name>
  <description>授权服务：角色/权限点/用户角色分配/数据权限 + 权限快照缓存（服务=自动配置库形态，照抄 service-tenant 范式）。</description>
  <dependencies>
    <!-- 服务=自动配置库（范式同 service-tenant）：data-starter 供 JPA/审计/软删/Flyway/Modulith 事件基建，
         spring-boot-starter 供 web/异常/前缀路由 -->
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-data-starter</artifactId></dependency>
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-spring-boot-starter</artifactId></dependency>
    <!-- 方法安全（@PreAuthorize role:manage 门禁经 starter 的 @EnableMethodSecurity 激活）+
         TenantContextHolder（监听器显式 set 租户） -->
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-security-starter</artifactId></dependency>
    <!-- 权限快照缓存（CacheFacade 装配点，Task 6 先行交付） -->
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-cache-starter</artifactId></dependency>
    <!-- 契约消费：authorization（UserPermissionsQuery/RolePermissionsChanged/错误码）、
         tenant（TenantCreated 监听建默认角色）——不消费 identity（权限不随密码变，无失效联动） -->
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-contract-authorization</artifactId></dependency>
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-contract-tenant</artifactId></dependency>
    <!-- 主代码直接使用的工件显式声明（防克隆模块时误判可用性）：platform-core（BusinessException）、
         platform-cache（CacheFacade）、platform-security（TenantContextHolder） -->
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-platform-core</artifactId></dependency>
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-platform-cache</artifactId></dependency>
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-platform-security</artifactId></dependency>
    <!-- tests -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>io.github.luckybearbear</groupId><artifactId>forge-platform-test</artifactId><scope>test</scope></dependency>
    <!-- TenantCreated 经 @ApplicationModuleListener 异步消费：事件断言需有界等待 -->
    <dependency><groupId>org.awaitility</groupId><artifactId>awaitility</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
