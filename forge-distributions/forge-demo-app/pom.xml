<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.luckybearbear</groupId>
    <artifactId>forge-distributions</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>forge-demo-app</artifactId>
  <name>Forge :: Distributions :: Demo App</name>
  <description>可运行 Demo：双业务模块演示契约 + 事件 + Modulith 边界</description>
  <dependencies>
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-contract-mold</artifactId>
    </dependency>
    <!-- 连库升级（Task 11）：JPA + 判别式租户多租户 + 审计 + Flyway + Modulith 事件 JDBC 登记表 -->
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-data-starter</artifactId>
    </dependency>
    <!-- 认证全链路接入（Task 8）：四服务 + security（TokenAuthFilter/方法安全）+ cache（权限快照）
         + audit（访问/错误日志落库）。四服务自动配置各自限定 domain 包，@EntityScan/
         @EnableJpaRepositories 声明累加共存（Task 3 遗留验证项，本模块上下文冒烟覆盖）。 -->
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-security-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-cache-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-audit-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-service-tenant</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-service-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-service-organization</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-service-authorization</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>
    <!-- Modulith 2.x 将 @ApplicationModuleListener 从 core 拆分至 events-api 工件（事件持久化基础设施
         events-core/events-jdbc 经 forge-data-starter → spring-modulith-starter-jdbc 传递引入，Task 11 恢复异步监听） -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-events-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 容器集成测试基座（AbstractIntegrationTest：PG/Redis @ServiceConnection；TenantTestSupport） -->
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-platform-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build><plugins>
    <plugin>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-maven-plugin</artifactId>
      <configuration>
        <skip>false</skip>
      </configuration>
      <executions>
        <execution>
          <goals><goal>repackage</goal></goals>
        </execution>
      </executions>
    </plugin>
  </plugins></build>
</project>
