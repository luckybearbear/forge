<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.luckybearbear</groupId>
    <artifactId>forge-platform</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>forge-platform-test</artifactId>
  <name>Forge :: Platform :: Test</name>
  <dependencies>
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-platform-core</artifactId>
    </dependency>
    <!-- TenantTestSupport 消费 TenantContextHolder（TTL 上下文 set/clear） -->
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-platform-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <!-- 容器集成测试基座（compile 供下游 test 引用传递，同 junit/assertj 约定）：
         spring-boot-testcontainers 提供 @ServiceConnection；Testcontainers 2.x 改名件由 Boot BOM 管版本 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
    </dependency>
  </dependencies>
</project>
