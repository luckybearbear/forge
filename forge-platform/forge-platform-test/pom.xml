<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.luckybearbear</groupId>
    <artifactId>forge-platform</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>forge-platform-test</artifactId>
  <name>Forge :: Platform :: Test</name>
  <dependencies>
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-platform-core</artifactId>
    </dependency>
    <!-- TenantTestSupport 消费 TenantContextHolder（TTL 上下文 set/clear） -->
    <dependency>
      <groupId>io.github.luckybearbear</groupId>
      <artifactId>forge-platform-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <!-- 容器集成测试基座（compile 供下游 test 引用传递，同 junit/assertj 约定）：
         spring-boot-testcontainers 提供 @ServiceConnection；Testcontainers 2.x 改名件由 Boot BOM 管版本 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
    </dependency>
    <!-- Boot 4 模块化：容器 ConnectionDetailsFactory 随技术工件分布（jar 实证 4.1.2）：
         JdbcContainerConnectionDetailsFactory 在 spring-boot-jdbc、RedisContainerConnectionDetailsFactory
         在 spring-boot-data-redis（4.1.2 BOM 无 spring-boot-redis 之名）。基类两容器均带
         @ServiceConnection，故本工件须自备两 factory，否则非 JPA/非 Redis 下游测试启动即
         ConnectionDetailsNotFoundException（Task 10 RED 实证：POSTGRES 源无 JDBC factory 即炸）。
         无连接池实现时 DataSourceAutoConfiguration 不装配 DataSource（PooledDataSource 条件），无副作用。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
    </dependency>
  </dependencies>
</project>
